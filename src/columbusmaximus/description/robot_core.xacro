<?xml version="1.0"?>
<robot name="columbusmaximus" xmlns:xacro="http://www.ros.org/wiki/xacro">

  
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_length" value="0.04"/>
  <xacro:property name="wheel_offset_x" value="-0.10"/>
  <xacro:property name="wheel_offset_y" value="0.18"/>
  <xacro:property name="wheel_offset_z" value="-0.05"/>

  <xacro:property name="caster_radius" value="0.02"/>
  <xacro:property name="caster_offset_x" value="0.15"/>
  <xacro:property name="caster_offset_z" value="-0.08"/>

  <link name="base_link"></link>


  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <geometry>
        <mesh filename="package://columbusmaximus/meshes/Assembly_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://columbusmaximus/meshes/Assembly_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.650241"/>
      <origin xyz="0.011769 0.018593 0.045881" rpy="0 0 0"/>
      <inertia ixx="0.00475461" ixy="-0.00000053" ixz="-0.00000189"
               iyy="0.00402814" iyz="-0.00058025" izz="0.00428233"/>
    </inertial>
  </link>

 
</robot>